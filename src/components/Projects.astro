---
import NavItem from "./NavItem.astro";
import Sections from "./Sections.astro";
import { projects as projectsEs } from "@cv";
import { projects as projectsEn } from "@cv-en"

const lang = Astro.currentLocale ?? 'es'
const projects = lang === 'en' ? projectsEn : projectsEs;

const content = lang === 'en' ? {
  title: 'Featured Projects',
  demo: 'Demo',
  repository: 'Repository'
} : {
  title: 'Proyectos Destacados',
  demo: 'Demo',
  repository: 'Repositorio'
}
---

<Sections sectionId="projects" title={content.title}>
  <ul class="grid w-full md:grid-cols-2 xl:grid-cols-3 xl:gap-4 gap-10">
    {
      projects.map(({ name, description, stack, demo, repo, image }) => {
        return (
          <div class="container animate-pulse-fade-in animate-duration-1000">
            <div class="container relative h-80 lg:h-106.25 xl:h-125 xl:pb-16 bg-card p-4 rounded-2xl hover:drop-shadow-primary-md transition-all duration-1000">
              <div class="lg:h-full lg:w-full flex flex-col items-center gap-4">
                <img
                  src={image}
                  alt={`imagen previa de ${name}`}
                  class="hidden xl:block"
                />
                <h3>{name}</h3>
                <p class="text-text">{description}</p>
                <div class="flex flex-wrap gap-1 w-full">
                  {stack.map((tech) => (
                    <span class="bg-primary text-secondary flex items-center justify-center px-1 py-0.5 rounded-full text-xs">
                      {tech}
                    </span>
                  ))}
                </div>
                <div class="absolute bottom-5 flex justify-around h-max w-full">
                  <NavItem url={demo} target="_blank">
                    {content.demo}
                  </NavItem>
                  <NavItem url={repo} target="_blank">
                    {content.repository}
                  </NavItem>
                </div>
              </div>
            </div>
          </div>
        );
      })
    }
  </ul>
</Sections>
