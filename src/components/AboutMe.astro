---
import { basics as basicsEs } from "@cv";
import { basics as basicsEn } from "@cv-en"
import Sections from "./Sections.astro";

const lang = Astro.currentLocale ?? 'es'
const { summary } = lang === 'en' ? basicsEn : basicsEs;
const titles = lang === 'en' ? {
  about: 'About Me'
} : {
  about: 'Sobre Mí'
}
---

<Sections sectionId="about-me" title={titles.about}>
  <div class="flex max-lg:flex-col items-center justify-between gap-4">
    <p class="max-lg:text-sm max-lg:w-full text-xl font-extralight w-3/5">
      {summary}
    </p>
    <img
      class="rounded-3xl w-80 drop-shadow-[0px_0px_10px_black]"
      src="/aboutme-img.webp"
      alt="Foto de Jahdiel Arciniegas"
    />
  </div>
</Sections>
